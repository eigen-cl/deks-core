{
  "name": "@deks-js/render-preview",
  "version": "0.2.2",
  "description": "Server-side PNG preview worker for DEKS presentations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigen-cl/deks-core.git",
    "directory": "packages/render-preview"
  },
  "homepage": "https://github.com/eigen-cl/deks-core#readme",
  "keywords": ["deks", "presentations", "preview", "playwright"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "deks-render-preview-worker": "dist/worker.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-browser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@deks-js/document": "0.3.0",
    "@deks-js/renderer-core": "0.5.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "playwright": "1.62.1"
  },
  "devDependencies": { "@types/node": "22.18.13", "esbuild": "0.28.2" }
}
