{
  "name": "@deks-js/document",
  "version": "4.1.0",
  "description": "Portable DEKS document types, validation, and pure editing commands.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigen-cl/deks-core.git",
    "directory": "packages/document"
  },
  "homepage": "https://github.com/eigen-cl/deks-core#readme",
  "keywords": [
    "deks",
    "presentations",
    "slides",
    "documents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./dist/schema/deks-document.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  }
}
